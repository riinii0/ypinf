# Supabase PostgreSQL 연결 (Supabase 대시보드 -> Connect -> ORMs -> Prisma)
DATABASE_URL=""
DIRECT_URL=""

# Supabase Auth (Supabase 대시보드 -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 데이터 소스 모드: mock | live
DATA_SOURCE_MODE="mock"

# 외부 공공데이터 API 키 (서버 전용, 승인 대기 중)
YOUTHCENTER_API_KEY=""
LOCAL_WELFARE_API_KEY=""

# 관리자 동기화·통계 엔드포인트 보호용 비밀키 (임의의 긴 문자열)
SYNC_SECRET=""

# Vercel Cron 자동 동기화용 비밀키
CRON_SECRET=""

# 개발 환경에서만 DRAFT 규칙을 판정에 포함할지 여부 (운영에서는 반드시 false)
ALLOW_DRAFT_RULES="false"

# 시연 모드용 고정 날짜 (YYYY-MM-DD, 비워 두면 오늘 날짜 사용)
DEMO_TODAY=""
